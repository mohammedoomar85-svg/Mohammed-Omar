# Copy this file to .env.local and fill in your Supabase project values.
# Supabase → Project Settings → API (or "Connect"): Project URL and the anon / publishable key.
# Never put the service_role / secret key here: it would ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
