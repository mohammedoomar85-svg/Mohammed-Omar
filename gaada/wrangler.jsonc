// Cloudflare Workers config for the Gaada store (static files only), separate from the Fizz & Play site.
// Deploy from this folder:  cd gaada && npx wrangler deploy
{
  "name": "gaada",
  "compatibility_date": "2025-06-01",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./dist" }
}
